    <!-- ================= Folder permission ================= -->
    <string name="permission_title">Allow access to statuses</string>
    <string name="permission_body">To show statuses, %1$s needs read access to the %2$s status folder. Your files never leave your device.</string>
    <string name="permission_step_1">Tap “Grant access” below</string>
    <string name="permission_step_2">On the next screen tap “Use this folder”</string>
    <string name="permission_step_3">Tap “Allow” to confirm</string>
    <string name="permission_grant">Grant access</string>
    <string name="permission_granted">Access granted</string>
    <string name="permission_wrong_folder_title">Wrong folder selected</string>
    <string name="permission_wrong_folder_body">Please select the “.Statuses” folder without changing location. Tap “Grant access” and then “Use this folder”.</string>
    <string name="permission_revoked_title">Access was removed</string>
    <string name="permission_revoked_body">Access to the %1$s status folder was revoked. Grant it again to keep viewing statuses.</string>
    <string name="permission_folder_missing">The status folder was not found. Open %1$s, view the Updates tab once and try again.</string>
    <string name="permission_why_title">Why is this needed?</string>
    <string name="permission_why_body">Android keeps status files in a protected folder. Android only lets apps read it after you approve that one folder. We do not access any other files.</string>
    <string name="permission_notifications_title">Stay updated</string>
    <string name="permission_notifications_body">Allow notifications to get alerts when new statuses are available or auto-saved.</string>
    <string name="permission_denied_permanently">Permission was denied. You can enable it from app settings.</string>
