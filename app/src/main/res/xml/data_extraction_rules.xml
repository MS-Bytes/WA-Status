<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device transfer (Android 12+): only app settings. The App Lock PIN hash,
     favorites database and caches are excluded by omission. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
