<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12+ (android:dataExtractionRules). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/security.preferences_pb" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/security.preferences_pb" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
