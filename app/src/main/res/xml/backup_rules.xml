<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 10–11 (android:fullBackupContent). -->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <!-- Never back up the App Lock PIN hash, device-specific folder grants or caches. -->
    <exclude domain="file" path="datastore/security.preferences_pb" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
